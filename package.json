{
  "name": "astroplate",
  "version": "5.8.1",
  "description": "Astro and Tailwindcss boilerplate",
  "author": "zeon.studio",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "resolutions": {
    "jws": "^4.0.0"
  },
  "scripts": {
    "dev": "yarn generate-json && netlify dev",
    "dev:astro": "yarn generate-json && astro dev",
    "build": "yarn generate-json && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier -w ./src",
    "generate-json": "node scripts/jsonGenerator.js",
    "remove-darkmode": "node scripts/removeDarkmode.js && yarn format",
    "import-brewer-spotlights": "node scripts/import-brewer-spotlights.js",
    "send-rcs-message": "node --env-file=.env.local scripts/send-rcs-message.js",
    "postinstall": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/check": "0.9.5",
    "@astrojs/mdx": "4.3.11",
    "@astrojs/netlify": "^6.6.3",
    "@astrojs/react": "4.4.2",
    "@astrojs/sitemap": "3.6.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1096.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.940.0",
    "@digi4care/astro-google-tagmanager": "^1.6.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@paypal/paypal-server-sdk": "^2.1.0",
    "astro": "5.15.9",
    "astro-auto-import": "^0.4.5",
    "astro-font": "^1.1.0",
    "date-fns": "^4.1.0",
    "disqus-react": "^1.1.7",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "swiper": "^12.0.3",
    "twilio": "^6.0.2",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "csv-parse": "^7.0.1",
    "eslint": "^9.39.1",
    "netlify-cli": "^23.12.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@parcel/watcher@2.5.1": true,
    "fsevents@2.3.3": true,
    "netlify-cli@23.15.1": true,
    "sharp@0.34.5": true,
    "sharp@0.34.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.2": true,
    "unix-dgram@2.0.7": true
  }
}
