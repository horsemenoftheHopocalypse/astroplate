---
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import ImageMod from "@/components/ImageMod.astro";
import { slugify } from "@/lib/utils/textConverter";

const brewerSpotlight = await getListPage(
  "brewerSpotlightSection",
  "brewer-spotlight",
);
const { title, description } = brewerSpotlight.data;
const spotlights = await getSinglePage("brewerSpotlights");

// Sort spotlights by last name
const sortedSpotlights = [...spotlights].sort((a, b) => {
  const lastNameA = a.data.name.split(" ").pop()?.toLowerCase() || "";
  const lastNameB = b.data.name.split(" ").pop()?.toLowerCase() || "";
  return lastNameA.localeCompare(lastNameB);
});
---

<Base title={title} meta_title={title} description={description}>
  <PageHeader title={title} />
  <section class="section-sm pb-0 pt-0">
    <div class="container">
      <div class="row justify-center mb-12">
        <div class="lg:col-8 text-center">
          <p class="text-lg">{description}</p>
        </div>
      </div>
      <div class="row justify-center">
        {
          sortedSpotlights.map((spotlight) => (
            <div class="mb-14 md:col-6 lg:col-4">
              <a href={`/brewer-spotlight/${slugify(spotlight.data.name)}`}>
                <div class="h-full rounded-lg bg-light dark:bg-darkmode-light p-8 text-center transition-all hover:shadow-lg">
                  {spotlight.data.avatar && (
                    <ImageMod
                      class="mx-auto mb-6 rounded-full"
                      src={spotlight.data.avatar}
                      alt={spotlight.data.name}
                      width={150}
                      height={150}
                      format="webp"
                    />
                  )}
                  <h3 class="h4 mb-2">{spotlight.data.name}</h3>
                  <p class="text-text-dark dark:text-white mb-2">
                    {spotlight.data.designation}
                  </p>
                  <p class="text-sm text-text-light dark:text-darkmode-text-light">
                    {spotlight.data.date}
                  </p>
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
